# AI-Medics Environment Configuration
# All sensitive credentials must come from environment variables.
# Do NOT commit real API keys or secrets to this file.

# GEMINI_API_KEY: Required for Gemini AI operations reasoning and strategic stress-test analysis.
# In Google AI Studio, this is automatically injected into process.env at runtime from user secrets.
# When running locally, obtain a free API key from https://aistudio.google.com/ and set it below.
GEMINI_API_KEY=

# APP_URL: The hosting URL for this deployment (injected by Cloud Run in AI Studio).
APP_URL=
